# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies (cache layer)
COPY repos/admin/package.json repos/admin/pnpm-lock.yaml ./
RUN printf 'onlyBuiltDependencies:\n  - "@parcel/watcher"\n  - esbuild\n  - simple-git-hooks\n  - vue-demi\n' > pnpm-workspace.yaml
RUN printf 'auto-install-peers=true\nshamefully-hoist=true\nonly-built-dependencies[]=@parcel/watcher\nonly-built-dependencies[]=esbuild\nonly-built-dependencies[]=simple-git-hooks\nonly-built-dependencies[]=vue-demi\n' > .npmrc
RUN pnpm install --no-frozen-lockfile --ignore-scripts \
    && pnpm rebuild esbuild @parcel/watcher vue-demi

# Copy source
COPY repos/admin/ .

# Build-time URLs (baked into the static bundle by Vite)
ARG HS_API_URL=http://localhost:3000
ARG HS_LOGIN_URL=http://localhost:3000
ARG HS_MEDIA_URL=http://localhost:3000
ARG HS_REPORTING_URL=http://localhost:3000

# Give Node enough heap for large bundles; skip unnecessary network ops at build time
ENV NODE_OPTIONS="--max-old-space-size=4096" \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NUXT_TELEMETRY_DISABLED=1

# Skip type-check in the container (CI should own that); just build the bundle
RUN printf 'VITE_API_BASE_URL=%s\nVITE_AUTH_API_BASE_URL=%s\nVITE_MEDIA_BASE_URL=%s\nVITE_REPORTING_BASE_URL=%s\nPUBLIC_API_BASE_URL=%s\nMEDIA_BASE_URL=%s\n' \
        "$HS_API_URL" "$HS_LOGIN_URL" "$HS_MEDIA_URL" "$HS_REPORTING_URL" "$HS_API_URL" "$HS_MEDIA_URL" > .env.production \
    && pnpm run build \
    && rm -f .env.production

# ── Stage 2: Serve with nginx ─────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
