# Build the browser target of the shared iOS, Android, and web customer app.
FROM node:25-alpine AS builder

WORKDIR /app

RUN npm install --global pnpm@11.20.0

COPY repos/mobile/package.json repos/mobile/pnpm-lock.yaml repos/mobile/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY repos/mobile/ .
COPY repos/mobile-public/ /app/public/

ARG HS_API_URL=https://api.alpha.homswag.com
ARG HS_BFF_URL=https://api.alpha.homswag.com/bff
ARG HS_MEDIA_URL=https://api.alpha.homswag.com
ARG HS_WS_URL=wss://api.alpha.homswag.com
ARG HS_MAPS_BROWSER_VALUE=
ARG HS_FEATURE_MAPS=true
ARG HS_FEATURE_DIRECTIONS=true

RUN printf 'VITE_API_BASE_URL=%s\nVITE_AUTH_API_BASE_URL=%s\nVITE_BFF_API_URL=%s\nVITE_BFF_BASE_URL=%s\nVITE_MEDIA_BASE_URL=%s\nVITE_WS_URL=%s\nVITE_GOOGLE_MAPS_API_KEY=%s\nVITE_FEATURE_MAPS=%s\nVITE_FEATURE_DIRECTIONS=%s\n' \
        "$HS_API_URL" "$HS_API_URL" "$HS_BFF_URL" "$HS_BFF_URL" "$HS_MEDIA_URL" "$HS_WS_URL" "$HS_MAPS_BROWSER_VALUE" "$HS_FEATURE_MAPS" "$HS_FEATURE_DIRECTIONS" > .env.prod \
    && pnpm run build:web \
    && rm -f .env.prod

FROM nginx:1.27-alpine AS runner

COPY --from=builder /app/dist/web /usr/share/nginx/html
COPY nginx/admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
