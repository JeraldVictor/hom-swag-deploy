# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Match the package manager declared by the server repository.
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

# Install exactly the dependency graph validated by the repository lockfile.
COPY repos/server/package.json repos/server/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY repos/server/ .
RUN pnpm build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

# Install production deps only
COPY --from=builder /app/package.json /app/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

# Copy compiled output
COPY --from=builder /app/dist ./dist

# Create runtime data directories. Production bind-mounts these from the deploy host.
RUN mkdir -p uploads/temp logs diagnostics

EXPOSE 3000

CMD ["node", "dist/index.cjs"]
