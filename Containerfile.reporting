# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM golang:1.26.4-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy module files
COPY repos/reporting/go.mod repos/reporting/go.sum ./

# Download dependencies
RUN go mod download

# Copy source
COPY repos/reporting/ .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o reporting ./cmd/reporting/main.go

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM alpine:latest AS runner

WORKDIR /app

# Install runtime dependencies (CA certificates for MinIO/TLS)
RUN apk add --no-cache ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /app/reporting .

# Run as non-root user
RUN adduser -D -u 1000 reporting
# Create directory for temp files
ENV REPORTING_TEMP_DIR=/tmp/reports

# Ensure mounted /tmp/reports always stays writable for the app user.
RUN mkdir -p /tmp/reports && chown -R reporting:reporting /tmp/reports && chmod 775 /tmp/reports
RUN cat > /entrypoint.sh <<'EOF'
#!/bin/sh
set -eu

REPORTING_TEMP_DIR="${REPORTING_TEMP_DIR:-/tmp/reports}"

mkdir -p "${REPORTING_TEMP_DIR}"
chown -R reporting:reporting "${REPORTING_TEMP_DIR}" || true
chmod 775 "${REPORTING_TEMP_DIR}" || true

exec su -s /bin/sh -c "./reporting" reporting
EOF
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

EXPOSE 3003
