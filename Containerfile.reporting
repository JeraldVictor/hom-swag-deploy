# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM golang:1.26.4-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy go.mod and go.sum (if it exists)
COPY reporting/go.mod ./
# COPY reporting/go.sum ./

# Download dependencies
RUN go mod download

# Copy source
COPY reporting/ .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o reporting ./cmd/reporting/main.go

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM alpine:latest AS runner

WORKDIR /app

# Install runtime dependencies (CA certificates for MinIO/TLS)
RUN apk add --no-cache ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /app/reporting .

# Create directory for temp files
RUN mkdir -p /tmp/reports

# Run as non-root user
RUN adduser -D -u 1000 reporting
USER reporting

EXPOSE 3003

CMD ["./reporting"]
