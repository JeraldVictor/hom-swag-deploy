# ============================================================
# HomSwag Deploy — Environment Variables
# Copy to .env.local or .env.prod and fill in the values.
#
# This file is loaded by:
#   - compose.yaml     → infra service config (ports, credentials)
#   - server container → full runtime config via env_file
# ============================================================

# ── Container registries and image tags ───────────────────────
COMPOSE_PROFILES=local-infra

# Deploy pulls app images from GitHub Container Registry.
IMAGE_REGISTRY=ghcr.io/jeraldvictor

# build-images.sh pushes only when --push is passed.
PUSH_REGISTRY=ghcr.io/jeraldvictor
BUILD_PLATFORM=linux/amd64

# Set to a specific digest/tag to pin a release, or leave as "latest".
SERVER_IMAGE_TAG=latest
ADMIN_IMAGE_TAG=latest
APP_IMAGE_TAG=latest
REPORTING_IMAGE_TAG=latest

KAFKA_IMAGE_TAG=latest
KAFKA_SOURCE_IMAGE=apache/kafka:latest
KAFKA_PLATFORM=linux/amd64

# Exact image references used by compose pull/deploy.
SERVER_IMAGE=ghcr.io/jeraldvictor/hom-swag-server:latest
REPORTING_IMAGE=ghcr.io/jeraldvictor/hom-swag-reporting:latest
ADMIN_IMAGE=ghcr.io/jeraldvictor/hom-swag-admin:latest
APP_IMAGE=ghcr.io/jeraldvictor/hom-swag-app:latest
KAFKA_IMAGE=ghcr.io/jeraldvictor/hom-swag-kafka:latest
CADDY_IMAGE=docker.io/caddy:2.8-alpine
NGINX_IMAGE=docker.io/nginx:1.27-alpine

# ── Exposed ports (host-side) ─────────────────────────────────
SERVER_PORT=3000
ADMIN_PORT=3001
APP_PORT=3002
REPORTING_PORT=3003
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
MONGO_PORT=27017
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_PORT=9094
# Redis is internal only — no external port is exposed

# ── Caddy / TLS routing ──────────────────────────────────────
PROXY_STACK=caddy
APP_DOMAIN=www.homswag.com
APEX_APP_DOMAIN=homswag.com
WWW_APP_DOMAIN=www.homswag.com
ADMIN_DOMAIN=admin.homswag.com
API_DOMAIN=api.alpha.homswag.com
REPORTING_DOMAIN=reporting.alpha.homswag.com
CADDY_CONFIG_PATH=./caddy/Caddyfile
NGINX_CERTS_PATH=./nginx/certs

# ── Deployment behavior ──────────────────────────────────────
SERVER_REPLICAS=1
REPORTING_REPLICAS=1
ADMIN_REPLICAS=1
APP_REPLICAS=1
DEPLOY_REPLICAS=2
CLEAN_REMOVE_VOLUMES=true

# ── Volume source overrides (optional) ───────────────────────
# Uncomment to mount a host path instead of a named Docker volume.
# MONGODB_DATA_SOURCE=/data/homswag/mongodb
# MINIO_DATA_SOURCE=/data/homswag/minio
# PORTAINER_DATA_SOURCE=/app/data/portainer
# SIGNOZ_DATA_SOURCE=/app/data/signoz
# SIGNOZ_CLICKHOUSE_DATA_SOURCE=/app/data/signoz-clickhouse
UPLOAD_SOURCE=./uploads
LOG_PATH=./logs

# ─────────────────────────────────────────────────────────────
# KAFKA & REPORTING
# ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BROKERS=kafka:9092
KAFKA_INTERNAL_HOST=kafka
KAFKA_EXTERNAL_HOST=127.0.0.1
REPORTING_SERVICE_URL=http://reporting:3000
REPORTING_REQUEST_TOPIC=homswag.reporting.requests
REPORTING_EVENT_TOPIC=homswag.reporting.events
REPORTING_DEAD_LETTER_TOPIC=homswag.reporting.dead-letter
REPORTING_CONSUMER_GROUP=homswag-reporting-workers
REPORTING_EVENTS_CONSUMER_GROUP=homswag-server-reporting-events
REPORTING_BUCKET=reports
REPORTING_API_TOKEN=
REPORTING_MAX_ROWS=200000
REPORTING_JOB_TTL_DAYS=30
REPORTING_SIGNED_URL_TTL_SECONDS=900
EARNINGS_MODE=shadow
AUTO_SEED_REPORT_DEFINITIONS=true
REPORTING_TEMP_DIR=/tmp/reports

# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=HomSwag
APP_URL=https://www.homswag.com

# ─────────────────────────────────────────────────────────────
# FRONTEND BUILD URLS
# ─────────────────────────────────────────────────────────────
# These are baked into admin/app images at build time by build-images.sh.
VITE_API_BASE_URL=https://api.alpha.homswag.com
VITE_AUTH_API_BASE_URL=https://api.alpha.homswag.com
VITE_MEDIA_BASE_URL=https://api.alpha.homswag.com
VITE_BFF_BASE_URL=https://api.alpha.homswag.com/bff
VITE_BFF_API_URL=https://api.alpha.homswag.com/bff
VITE_PARTNER_BFF_BASE_URL=https://partner.homswag.com
VITE_PARTNER_BFF_API_URL=https://partner.homswag.com/bff/field
VITE_PARTNER_WS_URL=wss://partner.homswag.com
VITE_WS_URL=wss://api.alpha.homswag.com
HS_REPORTING_URL=https://reporting.alpha.homswag.com
VITE_REPORTING_SERVICE_URL=https://reporting.alpha.homswag.com
VITE_REPORTING_BASE_URL=https://reporting.alpha.homswag.com
VITE_REPORTING_API_TOKEN=
VITE_CUSTOMER_APP_URL=https://www.homswag.com

# WARNING: SKIP_AUTH bypasses all authentication.
# Will throw an error and refuse to start if enabled in production.
SKIP_AUTH=false

CORS_ALLOWED_ORIGINS=https://www.homswag.com,https://homswag.com,https://admin.homswag.com

# ─────────────────────────────────────────────────────────────
# LOGGER
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_OTEL=false
OTEL_ENDPOINT=http://otel-collector:4318
OTEL_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
OTEL_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=api-server
OTEL_REPORTING_SERVICE_NAME=reporting-service
# Set true only in development/QA — exposes stack traces in HTTP responses
ERROR_INCLUDE_STACK=false
VITE_ENABLE_RUM=false
VITE_RUM_TRACES_ENDPOINT=https://www.homswag.com/otel/v1/traces
VITE_DEPLOYMENT_ENVIRONMENT=production
VITE_APP_RUM_SERVICE_NAME=customer-app
VITE_ADMIN_RUM_SERVICE_NAME=admin-app

OBSERVABILITY_STACK=false
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=30
DEPLOYMENT_ENVIRONMENT=production
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.129.1
OTEL_COLLECTOR_PULL_POLICY=always
OTEL_COLLECTOR_CONTAINER_NAME=homswag-otel-collector
OTEL_COLLECTOR_FORWARD_PORT=24224
OTEL_COLLECTOR_HEALTH_PORT=13133
OTEL_COLLECTOR_OTLP_HTTP_PORT=14318
OTEL_COLLECTOR_CORS_ALLOWED_ORIGIN_APP=https://www.homswag.com
OTEL_COLLECTOR_CORS_ALLOWED_ORIGIN_ADMIN=https://admin.homswag.com
PORTAINER_IMAGE=portainer/portainer-ce:2.30.1
PORTAINER_PULL_POLICY=always
PORTAINER_CONTAINER_NAME=homswag-portainer
PORTAINER_HTTP_BIND=127.0.0.1
PORTAINER_HTTP_PORT=8000
PORTAINER_HTTPS_BIND=127.0.0.1
PORTAINER_HTTPS_PORT=9443
PORTAINER_DOCKER_SOCKET=/var/run/docker.sock
SIGNOZ_IMAGE=signoz/signoz-standalone:latest
SIGNOZ_PULL_POLICY=always
SIGNOZ_CONTAINER_NAME=homswag-signoz
SIGNOZ_HTTP_BIND=127.0.0.1
SIGNOZ_HTTP_PORT=8080
SIGNOZ_OTLP_GRPC_BIND=127.0.0.1
SIGNOZ_OTLP_GRPC_PORT=4317
SIGNOZ_OTLP_HTTP_BIND=127.0.0.1
SIGNOZ_OTLP_HTTP_PORT=4318
# Replace these defaults before first boot.
SIGNOZ_USER_ROOT_ENABLED=true
SIGNOZ_USER_ROOT_ORG_NAME=hom-swag
SIGNOZ_USER_ROOT_EMAIL=admin@homswag.local
SIGNOZ_USER_ROOT_PASSWORD=change-this-root-password-strong
SIGNOZ_RETENTION_CONTAINER_NAME=homswag-signoz-retention
SIGNOZ_CLICKHOUSE_HOST=signoz
SIGNOZ_CLICKHOUSE_PORT=9000
SIGNOZ_RETENTION_DAYS=7
SIGNOZ_MAX_BYTES=5368709120
SIGNOZ_RETENTION_INTERVAL_SECONDS=3600
SIGNOZ_RETENTION_TRIM_STEP_SECONDS=21600
SIGNOZ_RETENTION_MUTATIONS_SYNC=1

# ─────────────────────────────────────────────────────────────
# MONGODB
# ─────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=changeme_strong_password
MONGODB_URI=mongodb://admin:changeme_strong_password@mongodb:27017/homswag?authSource=admin
MONGO_DATABASE=homswag

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=changeme_strong_password
REDIS_TLS=false

# ─────────────────────────────────────────────────────────────
# MINIO (S3-compatible object storage)
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=media
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_strong_password
MINIO_USE_SSL=false

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=604800
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=2592000
BFF_JWT_ACCESS_SECRET=change_this_bff_access_secret
BFF_JWT_REFRESH_SECRET=change_this_bff_refresh_secret

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────────────────────
# MEDIA STORAGE
# ─────────────────────────────────────────────────────────────
MEDIA_STORAGE_TYPE=minio
LOCAL_UPLOAD_DIR=uploads
LOCAL_PUBLIC_PATH=/uploads
MAX_FILE_SIZE=10485760
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_QUALITY=85
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
CDN_URL=
CDN_ENABLED=false

# ─────────────────────────────────────────────────────────────
# EMAIL (Zeptomail)
# ─────────────────────────────────────────────────────────────
ENABLE_EMAIL=false
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com
ZEPTOMAIL_FROM_EMAIL=noreply@homswag.com
ZEPTOMAIL_FROM_NAME=HomSwag

# ─────────────────────────────────────────────────────────────
# PAYMENT (ZohoPay)
# ─────────────────────────────────────────────────────────────
ZOHOPAY_AUTH_TOKEN=
ZOHOPAY_API_BASE_URL=https://payments.zoho.in/api/v1

# ─────────────────────────────────────────────────────────────
# GOOGLE MAPS
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# FEATURES
# ─────────────────────────────────────────────────────────────
ENABLE_CACHE=true
ENABLE_ANALYTICS=false
AUTOMATIC_ORDER_ASSIGN_ENABLED=false

# ─────────────────────────────────────────────────────────────
# SWAGGER / API DOCS (disable in production)
# ─────────────────────────────────────────────────────────────
ENABLE_SWAGGER=false

# ─────────────────────────────────────────────────────────────
# FIREBASE CLOUD MESSAGING (FCM) — Push Notifications
# ─────────────────────────────────────────────────────────────
# Paste the full contents of your Firebase service account JSON key as a
# single-line string (keep the surrounding single quotes).
# Download from: Firebase Console → Project Settings → Service Accounts
#                → Generate new private key
# Leave blank to disable FCM (notifications still work over Socket.IO).
# Example:
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"0","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'
FCM_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────
# DEV — SKIP AUTH (development only)
# ─────────────────────────────────────────────────────────────
DEV_SYSTEM_STAFF_ID=
DEV_SYSTEM_OFFICE_ID=
