# ============================================================
# HomSwag Deploy — Local Environment Variables
# ============================================================

# ── Container / Compose Config ──────────────────────────────
IMAGE_REGISTRY=homswag-local
PUSH_REGISTRY=ghcr.io/jeraldvictor
BUILD_PLATFORM=linux/amd64

SERVER_IMAGE_TAG=latest
ADMIN_IMAGE_TAG=local
APP_IMAGE_TAG=local
PARTNER_IMAGE_TAG=local
REPORTING_IMAGE_TAG=latest

KAFKA_IMAGE_TAG=latest
KAFKA_SOURCE_IMAGE=apache/kafka:latest
KAFKA_PLATFORM=linux/amd64

SERVER_IMAGE=homswag-local/hom-swag-server:latest
REPORTING_IMAGE=homswag-local/hom-swag-reporting:latest
ADMIN_IMAGE=homswag-local/hom-swag-admin:local
APP_IMAGE=homswag-local/hom-swag-app:local
PARTNER_IMAGE=homswag-local/hom-swag-partner:local
KAFKA_IMAGE=homswag-local/hom-swag-kafka:latest
PULL_IMAGES=false
SERVER_PULL_POLICY=never
REPORTING_PULL_POLICY=never
KAFKA_PULL_POLICY=never
ADMIN_PULL_POLICY=never
APP_PULL_POLICY=never
PARTNER_PULL_POLICY=never

# Host port bindings
HOST_BIND_ADDRESS=127.0.0.1
SERVER_PORT=3000
ADMIN_PORT=5173
APP_PORT=8080
PARTNER_PORT=8090
REPORTING_PORT=3003
NGINX_HTTP_PORT=8088
KAFKA_PORT=9095
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
KAFKA_CONTAINER_NAME=homswag-local-kafka
NGINX_CONTAINER_NAME=homswag-local-nginx

APP_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
API_DOMAIN=api.localhost
REPORTING_DOMAIN=reporting.localhost
PARTNER_DOMAIN=partner.localhost
NGINX_CERTS_PATH=./nginx/certs
NGINX_TEMPLATES_PATH=./nginx/local-templates

SERVER_REPLICAS=1
REPORTING_REPLICAS=1
ADMIN_REPLICAS=1
APP_REPLICAS=1
PARTNER_REPLICAS=1
DEPLOY_REPLICAS=2
CLEAN_REMOVE_VOLUMES=false
PRUNE_AFTER_DEPLOY=false

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BROKERS=kafka:9092
KAFKA_INTERNAL_HOST=kafka
KAFKA_EXTERNAL_HOST=127.0.0.1

# Storage Mount Sources (bind host paths)
# Local container data lives under deploy/volume-data and is gitignored.
MONGODB_DATA_SOURCE=./volume-data/mongodb
MONGODB_CONFIG_SOURCE=./volume-data/mongodb-config
REDIS_DATA_SOURCE=./volume-data/redis
MINIO_DATA_SOURCE=./volume-data/minio
KAFKA_DATA_SOURCE=./volume-data/kafka
KAFKA_SHARED_CONFIG_SOURCE=./volume-data/kafka-shared-config
KAFKA_SECRETS_SOURCE=./volume-data/kafka-secrets
NGINX_CACHE_SOURCE=./volume-data/nginx-cache
UPLOAD_SOURCE=./volume-data/uploads
LOG_PATH=./volume-data/logs

# ── Infrastructure ──────────────────────────────────────────

# MongoDB
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=dummypass
MONGODB_URI=mongodb://admin:dummypass@mongodb:27017/homswag?authSource=admin

# Redis
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_PASSWORD=wDjZofmvwVB4Xnk2GYC8
REDIS_TLS=false

# MinIO (S3-compatible)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=mvrzUP8gWow1P4Zvzoe8
MINIO_ENDPOINT=minio
MINIO_BUCKET=media
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=mvrzUP8gWow1P4Zvzoe8
MINIO_USE_SSL=false
MINIO_ENABLED=true

# ── Application (Server Runtime) ─────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:8080
SKIP_AUTH=true
CORS_ALLOWED_ORIGINS=*

# SSR server-side fetch URL (container-to-container)
SERVER_API_URL=http://server:3000
BFF_BASE_URL=http://server:3000/bff

# ── Security & JWT ───────────────────────────────────────────
JWT_SECRET=2efb3fdf536dcfed5868db25d4935b44
JWT_EXPIRES_IN=604800
JWT_REFRESH_SECRET=5bfcd150e4ac27bb572632f36f3dd80d22086251
JWT_REFRESH_EXPIRES_IN=2592000

# BFF (Mobile/Web) JWT Secrets
BFF_JWT_ACCESS_SECRET=2efb3fdf536dcfed5868db25d4935b44_bff
BFF_JWT_REFRESH_SECRET=5bfcd150e4ac27bb572632f36f3dd80d22086251_bff

# ── Logging & Observability ─────────────────────────────────
LOG_LEVEL=debug
ENABLE_OTEL=true
OTEL_ENDPOINT=http://otel-collector:4318
OTEL_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
OTEL_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=api-server
OTEL_REPORTING_SERVICE_NAME=reporting-service
ERROR_INCLUDE_STACK=true
VITE_ENABLE_RUM=true
VITE_RUM_TRACES_ENDPOINT=http://localhost:14318/v1/traces
VITE_DEPLOYMENT_ENVIRONMENT=development
VITE_APP_RUM_SERVICE_NAME=customer-app
VITE_ADMIN_RUM_SERVICE_NAME=admin-app

DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=30
DOCKER_LOG_FLUENTD_ADDRESS=127.0.0.1:24224
DOCKER_LOG_TAG=homswag
DEPLOYMENT_ENVIRONMENT=development
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.129.1
OTEL_COLLECTOR_PULL_POLICY=always
OTEL_COLLECTOR_CONTAINER_NAME=homswag-local-otel-collector
OTEL_COLLECTOR_FORWARD_PORT=24224
OTEL_COLLECTOR_HEALTH_PORT=13133
OTEL_COLLECTOR_OTLP_HTTP_PORT=14318
OTEL_COLLECTOR_CORS_ALLOWED_ORIGIN_APP=http://localhost:8080
OTEL_COLLECTOR_CORS_ALLOWED_ORIGIN_ADMIN=http://localhost:5173
OTEL_COLLECTOR_CORS_ALLOWED_ORIGIN_PARTNER=http://localhost:8090
# On macOS Docker Desktop, this can be /Users/<you>/.docker/run/docker.sock
# On Linux, use /var/run/docker.sock
PORTAINER_IMAGE=portainer/portainer-ce:2.30.1
PORTAINER_PULL_POLICY=always
PORTAINER_CONTAINER_NAME=homswag-local-portainer
PORTAINER_HTTP_PORT=8000
PORTAINER_HTTPS_PORT=9443
PORTAINER_DOCKER_SOCKET=/var/run/docker.sock
SIGNOZ_IMAGE=signoz/signoz-standalone:latest
SIGNOZ_PULL_POLICY=always
SIGNOZ_CONTAINER_NAME=homswag-local-signoz
SIGNOZ_HTTP_PORT=9080
SIGNOZ_OTLP_GRPC_PORT=4317
SIGNOZ_OTLP_HTTP_PORT=4318
# Replace these defaults before first boot.
SIGNOZ_USER_ROOT_ENABLED=true
SIGNOZ_USER_ROOT_ORG_NAME=hom-swag
SIGNOZ_USER_ROOT_EMAIL=admin@homswag.local
SIGNOZ_USER_ROOT_PASSWORD=change-this-root-password-strong
SIGNOZ_RETENTION_CONTAINER_NAME=homswag-local-signoz-retention
SIGNOZ_CLICKHOUSE_HOST=signoz
SIGNOZ_CLICKHOUSE_PORT=9000
SIGNOZ_RETENTION_DAYS=7
SIGNOZ_MAX_BYTES=5368709120
SIGNOZ_RETENTION_INTERVAL_SECONDS=3600
SIGNOZ_RETENTION_TRIM_STEP_SECONDS=21600
SIGNOZ_RETENTION_MUTATIONS_SYNC=1

# ── Media & Storage ─────────────────────────────────────────
MEDIA_STORAGE_TYPE=minio
LOCAL_UPLOAD_DIR=./volume-data/uploads
LOCAL_PUBLIC_PATH=/uploads

MAX_FILE_SIZE=10485760
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_QUALITY=85
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300

# ── Third-Party Services ────────────────────────────────────

# Google Maps
GOOGLE_MAPS_API_KEY=

# Email (Zeptomail)
ENABLE_EMAIL=false
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com
ZEPTOMAIL_FROM_EMAIL=noreply@homswag.com
ZEPTOMAIL_FROM_NAME=HomSwag

# Payment (ZohoPay)
ZOHOPAY_AUTH_TOKEN=
ZOHOPAY_API_BASE_URL=https://payments.zoho.in/api/v1

# Push Notifications (Firebase)
FCM_SERVICE_ACCOUNT_JSON=

# ── Features ────────────────────────────────────────────────
ENABLE_CACHE=true
ENABLE_ANALYTICS=false
CDN_ENABLED=false
CDN_URL=

# ── Legacy / Build-time Hints ──────────────────────────────
# NOTE: VITE_* vars are usually baked into images. 
# These are kept for reference or if the container uses them for runtime injection.
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_API_BASE_URL=http://localhost:3000
VITE_MEDIA_BASE_URL=http://localhost:3000
VITE_BFF_BASE_URL=http://localhost:3000/bff
VITE_PARTNER_BFF_API_URL=http://localhost:3000/bff/field
VITE_PARTNER_BFF_BASE_URL=http://localhost:3000
VITE_PARTNER_WS_URL=http://localhost:3000
HS_REPORTING_URL=http://localhost:3003
VITE_REPORTING_BASE_URL=http://localhost:3003
VITE_CUSTOMER_APP_URL=http://localhost:8080
VITE_PARTNER_APP_URL=http://localhost:8090
VITE_SIGNOZ_URL=http://localhost:9080
VITE_PORTAINER_URL=https://localhost:9443
VITE_MONITOR_URL=http://localhost:14318
